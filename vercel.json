{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/send-contact-email", "destination": "/api/send-email?type=contact" },
    { "source": "/api/send-verification-email", "destination": "/api/send-email?type=verification" },
    { "source": "/api/send-welcome-email", "destination": "/api/send-email?type=welcome" },
    { "source": "/api/send-password-reset-email", "destination": "/api/send-email?type=reset" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/analyze-decision.ts":    { "maxDuration": 60 },
    "api/analyze-pdf.ts":         { "maxDuration": 30 },
    "api/create-subscription.ts": { "maxDuration": 15 },
    "api/activate-plan.ts":       { "maxDuration": 15 },
    "api/expire-plan.ts":         { "maxDuration": 15 },
    "api/billing-portal.ts":      { "maxDuration": 15 },
    "api/analyze.ts":             { "maxDuration": 30 },
    "api/challenge-ai.ts":        { "maxDuration": 30 },
    "api/stripe-webhook.ts":      { "maxDuration": 15 },
    "api/send-email.ts":          { "maxDuration": 15 }
  }
}
