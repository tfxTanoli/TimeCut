rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True when the signed-in user's email is listed in config/admins.emails
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // ── Billing-critical fields ───────────────────────────────────────────────
    // These decide what a customer has paid for and what they have consumed.
    // They are written ONLY by the server (Admin SDK bypasses these rules) from
    // verified Stripe events and metered API routes. A client that could write
    // them could grant itself any plan and reset its own usage, which would
    // make every limit and feature gate unenforceable.
    function protectedUserFields() {
      return [
        'plan',
        'planStartDate',
        'planExpiresAt',
        'subscriptionStatus',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'creditsOverride',
        'freeReportsUsed',
        'freeReportsEarned'
      ];
    }

    // True when the incoming write leaves every protected field exactly as it is.
    function protectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(protectedUserFields().toSet());
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if isOwner() || isAdmin();

      // A brand-new account may only be created on the free plan, and may not
      // arrive pre-loaded with billing state.
      allow create: if isOwner()
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && !request.resource.data.keys().hasAny(
             ['planStartDate', 'planExpiresAt', 'subscriptionStatus',
              'stripeCustomerId', 'stripeSubscriptionId', 'creditsOverride',
              'freeReportsUsed', 'freeReportsEarned'].toSet()
           );

      // Owners may edit profile fields (name, email, lastLoginAt, referralCode,
      // lifetime stats) but never their plan or usage counters.
      // Admins may edit anything, which is how a Business account's
      // `creditsOverride` custom allocation is provisioned.
      allow update: if (isOwner() && protectedFieldsUnchanged()) || isAdmin();

      allow delete: if false;

      // Users can only read and write their own activity log
      match /activities/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Users can only read and write their own analyses
      match /analyses/{analysisId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy monthly counter. Read-only to the client; nothing writes it now.
      match /usage/{monthKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // AI Credits ledger — READ ONLY to the client. The UI subscribes to this
      // to show live balances; every debit and refund is written server-side by
      // api/_lib/entitlements.ts after the plan has been verified.
      match /credits/{monthKey} {
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow write: if false;
      }
    }

    // Admin allowlist — bootstrap-safe:
    //  • readable by everyone (the client gate reads it)
    //  • writable when no admins doc exists yet (first admin self-registers) OR
    //    by an existing admin, and the writer must keep their own email in the
    //    list (prevents lock-out / hijack after bootstrap).
    match /config/admins {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email in request.resource.data.emails
        && (
          !exists(/databases/$(database)/documents/config/admins)
          || isAdmin()
        );
    }

    // Other config (plan limits, credit costs, feature flags):
    // readable by everyone (needed for pricing/limits), writable only by admins.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Report feedback: submitted from the report page, read only by admins.
    //
    // Creation used to require nothing at all — not a session, not a size
    // limit — so anyone could script unlimited document creation straight into
    // this collection at our cost. Feedback is only ever offered to someone who
    // has just been shown a report, and that requires an account, so a signed-in
    // caller is now required and every field is bounded.
    function feedbackFieldsValid() {
      return request.resource.data.keys().hasAll(['helped', 'confidence', 'wouldHaveMissed'])
        && request.resource.data.keys().size() <= 12
        && request.resource.data.helped is string
        && request.resource.data.helped.size() <= 100
        && request.resource.data.confidence is string
        && request.resource.data.confidence.size() <= 100
        && request.resource.data.wouldHaveMissed is string
        && request.resource.data.wouldHaveMissed.size() <= 100
        && (!('mostValuableInsight' in request.resource.data)
            || (request.resource.data.mostValuableInsight is string
                && request.resource.data.mostValuableInsight.size() <= 2000))
        && (!('decisionGoal' in request.resource.data)
            || (request.resource.data.decisionGoal is string
                && request.resource.data.decisionGoal.size() <= 1000));
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null && feedbackFieldsValid();
      allow read, update, delete: if isAdmin();
    }

    // Anyone can submit a contact message (no auth required).
    //
    // Admins may read them. Every submission is also emailed to the support
    // address, but that is a single point of failure the app does not control —
    // if the support mailbox is misconfigured or the mail is rejected, the
    // Firestore copy was previously unreadable by anyone, so the message was
    // simply lost. Reading is the whole point of storing them.
    //
    // Writes stay closed: a submitted message is a record of what the customer
    // actually sent, and nothing should be able to edit it after the fact.
    // Sizes are bounded here as well as in the form and the API. Without them
    // this was an unauthenticated write of up to 1MB per document, repeatable
    // as fast as a script could issue it — a direct route to a Firestore bill
    // with no UI involved. The API's own rate limits do not apply to a client
    // writing straight to Firestore, so the ceiling has to live in the rules.
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message'])
        && request.resource.data.keys().size() <= 8
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Newsletter signups from the blog. Same shape of protection as contacts:
    // open to anyone (that is the point of a signup box) but bounded, write
    // only, and readable only by an admin. The document id is the address, so
    // signing up twice overwrites rather than piling up duplicates.
    match /newsletter/{email} {
      allow create, update: if request.resource.data.keys().hasAll(['email'])
        && request.resource.data.keys().size() <= 4
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200;
      allow read, delete: if isAdmin();
    }

    // Rate-limit counters for the public API routes. Written only by the
    // server (the Admin SDK bypasses these rules); a client that could edit
    // them could lift its own limits, which is the whole point of having them.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ── AI usage & cost ledger ───────────────────────────────────────────────
    // Written ONLY by the server (the Admin SDK bypasses these rules) after a
    // successful OpenAI call. Readable by admins so the dashboard can report
    // real spend. Never client-writable: these numbers are what margin
    // decisions get made on, so a client that could forge them would make the
    // whole dashboard worthless.
    match /aiUsage/{recordId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /aiUsageMonthly/{monthKey} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /aiUsageByUser/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
